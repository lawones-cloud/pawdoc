# Supabase — get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenRouter — get from https://openrouter.ai/keys
# NOTE: Never expose this key client-side. Use Supabase Edge Functions as proxy.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# PostHog — get from https://app.posthog.com/settings/project
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your-key-here
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
