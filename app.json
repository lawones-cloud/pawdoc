{
  "expo": {
    "name": "PawDoc",
    "slug": "pawdoc",
    "scheme": "pawdoc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "primaryColor": "#2D6A4F",
    "privacy": "This app requires access to your device to provide AI-powered pet health guidance.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lawones.pawdoc",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "PawDoc sends you reminders for your pet's medications and vet appointments.",
        "NSLocationWhenInUseUsageDescription": "PawDoc uses your location to help find the nearest emergency vet in urgent situations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6A4F"
      },
      "package": "com.lawones.pawdoc",
      "versionCode": 1,
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2D6A4F"
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}